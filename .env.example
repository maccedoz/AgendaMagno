# npm run setup cria .env com segredos aleatórios. Não publique esse arquivo.
APP_URL=http://localhost:3000
PANEL_PASSWORD=
# No ambiente publicado, prefira o hash e remova a senha em texto acima.
# Gere com: npm run senha:hash
# PANEL_PASSWORD_HASH=
# 32 bytes em hexadecimal (64 caracteres), gerados pelo setup; protege as chaves da IA.
# Preserve este valor entre deploys e junto dos backups. Também aceita base64 de 32 bytes.
LLM_ENCRYPTION_KEY=
# Opcional localmente; necessário para autenticar o cron diário na Vercel.
CRON_SECRET=
# Local: PostgreSQL embutido em .data. Produção: postgres + URL do Neon (SSL).
DATABASE_MODE=local
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/agenda

# Cadastre provedores, modelos, chaves e limites de IA no painel do aplicativo.
# Não use NEXT_PUBLIC_* para senhas, chaves ou conexão de banco.

# PostgreSQL: schema aplicado somente por npm run db:migrate com credencial administrativa.
# No app publicado use DATABASE_URL com usuário restrito (scripts/runtime-role.sql).
# Configure DATABASE_MIGRATION_URL apenas na máquina/CI que executa as migrações.
# DATABASE_MIGRATION_URL=
DATABASE_AUTO_MIGRATE=false

# Lembretes com o app fechado (Web Push). Opcional: sem as três, só a tela aberta avisa.
# Gere o par com: npm run push:keys. Trocar as chaves exige reativar os lembretes em cada aparelho.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@exemplo.com
