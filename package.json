{
  "name": "agendamagno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:sql": "node --import tsx scripts/migrate.ts --sql",
    "db:migrate": "node --import tsx --env-file-if-exists=.env scripts/migrate.ts",
    "deploy:check": "node --import tsx --env-file-if-exists=.env.production scripts/deploy-check.ts",
    "senha:hash": "node scripts/password-hash.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
